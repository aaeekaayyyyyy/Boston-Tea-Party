{
  "description": "Benchmark cases for filing status rules",
  "rules_file": "src/rules/filing_status/filing_status.yaml",
  "cases": [
    {
      "case_id": "HOH_01",
      "description": "Married but considered unmarried - HOH eligible with qualifying child. Note: marital_status_on_1231 head_of_household is derived when married + lived_with_spouse_last_6_months false + paid_more_than_half_home_costs true.",
      "facts": {
        "marital_status_on_1231": "head_of_household",
        "lived_with_spouse_last_6_months": false,
        "paid_more_than_half_home_costs": true,
        "has_qualifying_child": true,
        "qualifying_person_lived_with_taxpayer_more_than_half_of_year": true,
        "has_qualifying_person": true,
        "considered_unmarried": true,
        "eligible_for_qss": false,
        "eligible_for_hoh": true
      },
      "expected": {
        "valid_filing_statuses": ["head_of_household"]
      }
    },
    {
      "case_id": "SINGLE_01",
      "description": "Single filer, not eligible for HOH or QSS",
      "facts": {
        "marital_status_on_1231": "single",
        "eligible_for_qss": false,
        "eligible_for_hoh": false
      },
      "expected": {
        "valid_filing_statuses": ["single"]
      }
    },
    {
      "case_id": "SINGLE_02",
      "description": "Widowed, not QSS or HOH eligible",
      "facts": {
        "marital_status_on_1231": "widowed",
        "eligible_for_qss": false,
        "eligible_for_hoh": false
      },
      "expected": {
        "valid_filing_statuses": ["single"]
      }
    },
    {
      "case_id": "MFJ_01",
      "description": "Married filing jointly - spouse agrees",
      "facts": {
        "marital_status_on_1231": "married",
        "spouse_willing_to_file_jointly": true
      },
      "expected": {
        "valid_filing_statuses": ["married_filing_jointly", "married_filing_separately"]
      }
    },
    {
      "case_id": "MFS_01",
      "description": "Married filing separately - spouse does not agree to joint",
      "facts": {
        "marital_status_on_1231": "married",
        "spouse_willing_to_file_jointly": false
      },
      "expected": {
        "valid_filing_statuses": ["married_filing_separately"]
      }
    },
    {
      "case_id": "QSS_01",
      "description": "Qualifying surviving spouse",
      "facts": {
        "marital_status_on_1231": "qualifying_surviving_spouse"
      },
      "expected": {
        "valid_filing_statuses": ["qualifying_surviving_spouse"]
      }
    },
    {
      "case_id": "HOH_NO_QUALIFYING_PERSON",
      "description": "HOH status but no qualifying person - should not get HOH",
      "facts": {
        "marital_status_on_1231": "head_of_household",
        "has_qualifying_person": false,
        "considered_unmarried": true,
        "eligible_for_qss": false,
        "eligible_for_hoh": true
      },
      "expected": {
        "valid_filing_statuses": []
      }
    }
  ]
}
